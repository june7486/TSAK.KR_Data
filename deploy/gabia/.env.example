# ══════════════════════════════════════════════════════════════════════
#  TSAK 인가자 관리 — 환경변수 예시
# ══════════════════════════════════════════════════════════════════════
#
#  이 파일은 **이름 · 용도 · 필수 여부**만 담습니다. 실제 값은 절대 여기에
#  적지 마세요. 값은 서버의 `~/tsak/shared/config.json`(권한 600)에 두거나,
#  systemd Environment= 로 주입합니다.
#
#  ## 우선순위
#    환경변수  >  config.json  >  코드 기본값
#    (단, TSAK_STATE_DIR / TSAK_APP_ROOT / TSAK_PORT 는 환경변수가 최우선)
#
#  ## 검증
#    필수값이 비면 기동 즉시 SystemExit 로 **무엇이 없는지** 알려줍니다.
#      "[config] 필수 설정이 없습니다: nas.base (또는 TSAK_NAS_BASE), ..."
#
#  작성: 2026-11-20 · TSAK
# ══════════════════════════════════════════════════════════════════════


# ──────────────────────────────────────────────────────────────────────
#  A. 실행 위치 · 포트  (필수)
# ──────────────────────────────────────────────────────────────────────

# 수신 포트. 0.0.0.0:<이 값> 으로 바인딩한다.
# 필수: 아니오 (기본값 5071)
# 값 예: 5071
# 주의: 방화벽·리버스프록시(nginx) 업스트림 포트와 반드시 일치시킬 것.
TSAK_PORT=5071

# 웹 정적 파일(build/web)이 있는 디렉터리. 절대경로.
# 필수: 아니오 (기본값: <코드루트>/../web → <코드루트>/web → build/web 순 자동 탐색)
# 값 예: /home/tsak/tsak/current/web
TSAK_STATIC_DIR=

# 코드(프록시 파이썬 파일)가 있는 디렉터리. 릴리스 교체와 무관하게 고정.
# 필수: 아니오 (기본값: proxy_server.py 가 있는 디렉터리)
# 값 예: /home/tsak/tsak/current/api
# 주의: 이 값을 지정하면 릴리스 전환 시 함께 바뀌지 않는다(보통 미지정이 맞다).
TSAK_APP_ROOT=

# ★중요★ 사용자 상태(세션·관리자 업로드·캐시)를 두는 디렉터리.
# 필수: **예 (릴리스 디렉터리 구조로 배포하는 경우)**
# 값 예: /home/tsak/tsak/shared/state
# 이유: 코드와 상태를 분리하지 않으면 릴리스 교체·롤백 때
#       로그인 세션과 업로드 이미지가 사라진다(실제로 그럴 뻔했다).
#       미지정 시 코드 위치와 동일 → 샌드박스 동작은 그대로.
TSAK_STATE_DIR=


# ──────────────────────────────────────────────────────────────────────
#  B. NAS 접속  (필수 — 이 앱의 DB·첨부파일이 전부 NAS 에 있다)
# ──────────────────────────────────────────────────────────────────────

# Synology NAS 주소(https, 포트 포함).
# 필수: **예**
# 값 예: https://<NAS 주소>:5001
TSAK_NAS_BASE=

# NAS 계정.
# 필수: **예**
# 주의: 현재 이 값과 TSAK_APP_PW 가 **동일한 문자열**이다(공용 자격증명).
#       분리를 권고한다 — ③ 결정 필요 항목 참고.
TSAK_NAS_USER=

# NAS 비밀번호.
# 필수: **예**
# 주의: 평문이다. config.json(권한 600) 또는 systemd Environment= 로만 두고
#       git·문서·메일·채팅에 절대 넣지 말 것.
TSAK_NAS_PW=

# NAS 안에서 이 앱이 쓰는 최상위 폴더.
# 필수: 아니오 (기본값 /92_Tiger_app_data/TSAK_인가자관리)
TSAK_NAS_BASE_PATH=

# NAS 연결 재사용 풀 크기(동시 연결 수).
# 필수: 아니오 (기본값 8)
TSAK_NAS_POOL=8


# ──────────────────────────────────────────────────────────────────────
#  C. NAS TLS 인증서 검증  (필수 — 권장값 그대로 쓰십시오)
# ──────────────────────────────────────────────────────────────────────

# TLS 검증 정책.
#   pin    = (기본·권장) 인증서 지문(SHA-256)을 고정 대조. 사설 자체서명
#            인증서라도 지문이 맞으면 통과, 다르면 즉시 차단.
#   strict = 공인 CA 체인 + 호스트명 검증. NAS 가 자체서명이면 **연결 실패**.
#   off    = 검증 안 함. ★비상시에만. 공용 인터넷 구간에서 쓰면 위험.
# 필수: 아니오 (기본값 pin)
# 주의: 종전 코드는 사실상 off(CERT_NONE) 였다. 가비아로 옮기면 NAS 트래픽이
#       공용 인터넷을 지나므로 반드시 pin 이상을 유지할 것.
TSAK_NAS_TLS_MODE=pin

# 고정할 인증서 지문(SHA-256, 콜론·공백 무관).
# 필수: 아니오 (코드에 내장된 기본 지문 사용)
# 기본 내장 지문 만료일: 2027-05-02
# ★ NAS 인증서를 갱신하면 이 값을 **반드시** 새 지문으로 바꿔야 한다.
#   안 바꾸면 앱 전체가 NAS 접속 실패로 멈춘다(증상: 모든 화면 "불러오기 실패").
TSAK_NAS_CERT_SHA256=


# ──────────────────────────────────────────────────────────────────────
#  D. 로그인 비밀번호  (필수)
# ──────────────────────────────────────────────────────────────────────

# 마스터 비밀번호의 **해시**. 평문보다 이쪽을 권장(파일·git 에 평문 미보관).
# 필수: 아래 TSAK_MASTER_PW 와 **둘 중 하나는 반드시**
# 값 형식: 해시 문자열(현재 저장 방식과 동일하게 생성)
TSAK_MASTER_HASH=

# 마스터 비밀번호 **평문**. 해시를 못 만들 때만 임시로 사용.
# 필수: TSAK_MASTER_HASH 와 둘 중 하나
# 주의: 평문 노출 위험. 가능하면 TSAK_MASTER_HASH 를 쓰십시오.
TSAK_MASTER_PW=

# 관리자 앱(app 등급) 공통 비밀번호.
# 필수: **예**
# 주의: 현재 TSAK_NAS_PW 와 동일한 값이다(공용 자격증명). 분리를 권고한다.
TSAK_APP_PW=


# ──────────────────────────────────────────────────────────────────────
#  E. DB 저장 방식 (선택 — 가비아에서만 켜는 것을 검토)
# ──────────────────────────────────────────────────────────────────────

# DB JSON 을 로컬 디스크에서 읽고 쓸지 여부(사진·영상은 계속 NAS).
# 필수: 아니오 (기본값 0 = 끔, 현행 동작)
#   1 = 켬. NAS 왕복 지연이 사라져 체감 속도가 크게 좋아진다.
#       단, NAS 동시기록(raid)이 정상 동작하는지 반드시 확인할 것.
# 주의: 지금 샌드박스에서는 꺼져 있다. 켜면 NAS 와 로컬 양쪽에 쓰이므로
#       "어느 쪽이 진짜인가"를 운영자가 알고 있어야 한다.
TSAK_LOCAL_DB=0

# 위 모드에서 로컬 DB 사본을 둘 디렉터리.
# 필수: 아니오 (기본값 <TSAK_STATE_DIR>/local_db_store)
TSAK_LOCAL_DB_DIR=


# ──────────────────────────────────────────────────────────────────────
#  F. Google Drive 백엔드 (선택 — NAS 를 안 쓸 경우에만)
# ──────────────────────────────────────────────────────────────────────

# ※ 백엔드 선택에는 **환경변수가 없다**. config.json 의 "backend" 키로만 바꾼다.
#      (auto | nas | gdrive · 기본값 auto)
#      auto = 구글 인증정보가 있으면 gdrive, 없으면 nas.
#   현재 운영: nas (deploy 번들에 구글 인증정보가 비어 있음)

# 구글 서비스 계정 JSON 파일 경로.
# 필수: 아니오 (gdrive 백엔드를 쓸 때만)
TSAK_GDRIVE_SA=

# 구글 드라이브 최상위 폴더 ID.
# 필수: 아니오 (gdrive 백엔드를 쓸 때만)
TSAK_GDRIVE_ROOT=

# 드라이브 안의 기준 경로.
# 필수: 아니오
TSAK_GDRIVE_BASE_PATH=

# OAuth 클라이언트 시크릿 파일 경로.
# 필수: 아니오
TSAK_GDRIVE_CLIENT_SECRET=

# OAuth 토큰 파일 경로.
# 필수: 아니오 (기본값 <TSAK_STATE_DIR>/.gdrive_token.json)
# 주의: 이 파일은 **자격증명**이다. git·백업 공유 금지.
TSAK_GDRIVE_TOKEN=


# ──────────────────────────────────────────────────────────────────────
#  G. 성능 · 캐시 (선택 — 기본값으로 충분)
# ──────────────────────────────────────────────────────────────────────

# 썸네일 생성 동시 실행 수.
# 필수: 아니오 (기본값 4 · 현재 샌드박스는 5)
# 주의: 높이면 NAS·CPU 부하가 커진다. 낮으면 썸네일이 늦게 뜬다.
TSAK_THUMB_CONC=4

# 썸네일 생성 워커 스레드 수.
# 필수: 아니오 (기본값 3)
TSAK_THUMB_WORKERS=3

# 미디어 캐시 최대 크기(바이트).
# 필수: 아니오 (기본값 157286400 = 150MB)
TSAK_MEDIA_CACHE_MAX=

# 미디어 캐시를 채우지 않을 최소 여유 디스크(바이트).
# 필수: 아니오 (기본값 524288000 = 500MB)
# 주의: 디스크가 이보다 적게 남으면 캐시를 포기한다(디스크 고갈 방지).
TSAK_MEDIA_MIN_FREE=

# 로컬 스토어 단일 파일 최대 크기(바이트).
# 필수: 아니오 (기본값 25165824 = 24MB)
TSAK_STORE_MAX_BLOB=

# 로컬 스토어 총 사용량 상한(바이트). 초과 시 오래된 것부터 자동 정리.
# 필수: 아니오 (기본값 3221225472 = 3GB)
TSAK_STORE_MAX_TOTAL=

# 행사 목록 캐시 유효기간(초).
# 필수: 아니오 (기본값 150)
TSAK_EV_LIST_TTL=

# 행사 목록 캐시가 이 시간(초)을 넘으면 낡은 것으로 보고 재조회.
# 필수: 아니오 (기본값 3600)
TSAK_EV_LIST_STALE=

# 행사 메타데이터 캐시 유효기간(초).
# 필수: 아니오 (기본값 90)
TSAK_EV_META_TTL=


# ──────────────────────────────────────────────────────────────────────
#  H. 선택 모듈 (설치되어 있으면 자동 사용 · 없으면 기능만 비활성)
# ──────────────────────────────────────────────────────────────────────

# 이 앱의 파이썬 외부 패키지는 대부분 "있으면 쓰고 없으면 건너뛰는" 구조다.
# 다만 아래 하나는 **필수**다.
#
#   openpyxl  → 엑셀(.xlsx) 읽기/쓰기. 명단 가져오기·재무 내보내기에 쓰인다.
#               없으면 해당 기능이 조용히 실패한다. requirements.txt 에 선언됨.
#
# 아래는 선택이다(없어도 기동·일반 화면은 정상).
#   PIL(Pillow)  → 이미지 크롭·썸네일·수품 사진 자동 자르기
#   brotli       → gzip 대신 더 작은 압축 전송(체감 속도)
#   numpy        → 수품 사진 자동 크롭 품질 향상
#   pytesseract  → 스캔 PDF/이미지 OCR (tesseract 바이너리도 별도 필요)
#   PyMuPDF(fitz) → PDF 페이지 렌더 후 OCR
#   xlrd         → 구형 .xls 읽기
#   python-docx  → 워드(.docx) 읽기
#   google-api-python-client / google-auth-oauthlib → gdrive 백엔드
#
# 설치 예(우분투 24.04):
#   sudo apt install -y python3-openpyxl python3-pil python3-numpy \
#        python3-pytesseract tesseract-ocr-eng tesseract-ocr-kor \
#        python3-docx python3-brotli
#   pip3 install --break-system-packages PyMuPDF xlrd
